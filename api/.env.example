# JWT Secret for authentication
JWT_SECRET=your-super-secret-jwt-key-change-me

# Admin API Key for dashboard access
ADMIN_API_KEY=bawwab-admin-key-change-me

# API Port (default: 3001)
PORT=3001

# Host (default: 0.0.0.0)
HOST=0.0.0.0

# Redis URL (optional, falls back to in-memory)
# REDIS_URL=redis://localhost:6379

# Log Level (debug, info, warn, error)
LOG_LEVEL=info

# Provider API Keys (add your keys here)
# OPENROUTER_API_KEY=your-openrouter-key
# ANTHROPIC_API_KEY=your-anthropic-key
# OPENAI_API_KEY=your-openai-key
# DEEPSEEK_API_KEY=your-deepseek-key
# GEMINI_API_KEY=your-gemini-key
# GLM_API_KEY=your-glm-key

# Token Optimizer Config (optional)
# TOKEN_OPTIMIZER_CONFIG={"enabled":true,"compressionLevel":"medium","deduplicateToolResults":true}

# Rate Limit (requests per minute)
RATE_LIMIT=100
